# ===========================================
# API Service - Production Dockerfile
# ===========================================

# =====================
# Base Stage
# =====================
FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
RUN apk add --no-cache libc6-compat curl
WORKDIR /app

# =====================
# Dependencies Stage
# =====================
FROM base AS deps

# Copy workspace configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy all package.json files needed for API
COPY apps/api/package.json ./apps/api/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/permissions/package.json ./packages/permissions/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# =====================
# Builder Stage
# =====================
FROM base AS builder
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Install dependencies to ensure workspace linking
RUN pnpm install --frozen-lockfile

# Build shared packages first
RUN pnpm --filter @moltbuddy/permissions build || true

# Build API
RUN pnpm --filter @moltbuddy/api build

# =====================
# Production Stage
# =====================
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 apiuser

# Copy workspace files
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./

# Copy built API
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/

# Copy built packages
COPY --from=builder /app/packages/permissions/dist ./packages/permissions/dist
COPY --from=builder /app/packages/permissions/package.json ./packages/permissions/

# Install production dependencies only
RUN pnpm install --prod --frozen-lockfile --ignore-scripts

# Change ownership
RUN chown -R apiuser:nodejs /app

USER apiuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["node", "apps/api/dist/nodeIndex.js"]
