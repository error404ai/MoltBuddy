NODE_ENV=production
PORT=3000
EXTERNAL_PORT=3000

# MySQL (Docker)
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
MYSQL_DATABASE=moltbuddy_db
MYSQL_USER=moltbuddy
MYSQL_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
MYSQL_EXTERNAL_PORT=3306

# App DB connection (backend)
DB_HOST=db
DB_PORT=3306
DB_USERNAME=moltbuddy
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=moltbuddy_db

# CORS
CORS_ORIGIN=https://dashboard.yourdomain.com

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# Email (optional)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yourdomain.com
