# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env.prod and fill in real values
# ===========================================

NODE_ENV=production

# ===========================================
# DATABASE CONFIGURATION
# Use strong passwords in production!
# ===========================================

# MySQL Configuration
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
MYSQL_DATABASE=moltbuddy_db
MYSQL_USER=moltbuddy
MYSQL_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Database Connection (for apps)
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=moltbuddy
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=moltbuddy_db

# ===========================================
# CORS CONFIGURATION
# Update with your actual domain
# ===========================================

CORS_ORIGIN=https://dashboard.yourdomain.com

# ===========================================
# JWT CONFIGURATION
# Generate a strong secret key!
# ===========================================

JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================

REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ===========================================
# DOMAIN CONFIGURATION
# Update these with your actual domains
# ===========================================

API_DOMAIN=api.yourdomain.com
DASHBOARD_DOMAIN=dashboard.yourdomain.com
