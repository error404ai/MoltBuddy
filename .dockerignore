# ===========================================
# Docker Ignore File
# Exclude unnecessary files from build context
# ===========================================

# Dependencies
node_modules
**/node_modules
**/.pnpm-store

# Build outputs
**/dist
**/.next
**/build
**/.turbo

# Version control
.git
.gitignore
**/.git

# IDE and editors
.vscode
.idea
**/*.swp
**/*.swo
**/*~

# Environment files (use docker secrets or env vars instead)
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/coverage
**/__tests__

# Documentation
*.md
!README.md
docs
CLAUDE.md

# Docker files (avoid recursive builds)
**/Dockerfile*
**/docker-compose*.yml
docker

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp
temp
*.tmp
*.temp

# Cache
.cache
**/.cache
.eslintcache
.stylelintcache

# Misc
*.tgz
*.tar.gz
*.zip
