{
  "name": "moltbuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc -b tsconfig.json --force && tsc-alias",
    "build:frontend": "cd frontend && pnpm run build",
    "build:all": "pnpm run build && pnpm run build:frontend",
    "predev": "pnpm run build",
    "dev:types": "tsc -b tsconfig.json --watch --preserveWatchOutput",
    "dev:aliases": "tsc-alias -w",
    "dev:serve": "cross-env NODE_ENV=development nodemon",
    "dev:backend": "concurrently -k -n BUILD,ALIAS,SERVER -c cyan,magenta,green \"pnpm run dev:types\" \"pnpm run dev:aliases\" \"pnpm run dev:serve\"",
    "dev:frontend": "cd frontend && pnpm run dev",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "install:frontend": "cd frontend && pnpm install",
    "install:all": "pnpm install && pnpm run install:frontend",
    "migrate:generate": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:generate ./src/migrations/auto-generated --dataSource src/loaders/database.ts",
    "migrate:create": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:create ./src/migrations/migration",
    "migrate:run": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:run --dataSource src/loaders/database.ts",
    "migrate:revert": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js migration:revert --dataSource src/loaders/database.ts",
    "db:sync": "cross-env NODE_ENV=development node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js schema:sync --dataSource src/loaders/database.ts",
    "db:drop": "node --import ./scripts/ts-node-loader.mjs ./node_modules/typeorm/cli.js schema:drop --dataSource src/loaders/database.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "docker:dev": "docker compose up -d",
    "docker:dev:build": "docker compose up -d --build",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:clean": "docker system prune -af && docker volume prune -f"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.20",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.0.0"
}
